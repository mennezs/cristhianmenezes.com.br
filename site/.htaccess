# Páginas de erro personalizadas (Apache / cPanel). Ficam em /errors/.
# Use caminho absoluto a partir da raiz do site. NÃO use URL completa
# (https://...), senão o Apache faz redirect e o navegador recebe 302 em vez do código real.
ErrorDocument 403 /errors/403.html
ErrorDocument 404 /errors/404.html
ErrorDocument 500 /errors/500.html
ErrorDocument 502 /errors/502.html
ErrorDocument 503 /errors/503.html
ErrorDocument 504 /errors/504.html

# O service worker não pode ficar em cache, senão atualizações dele demoram a chegar.
<Files "sw.js">
  <IfModule mod_headers.c>
    Header set Cache-Control "no-cache"
  </IfModule>
</Files>

